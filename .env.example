PORT=4010

# Dedicated Training database (NOT SaloncappRepo's main DB)
MONGODB_URI=mongodb://127.0.0.1:27017/saloncapp_sop_trainer
NEXTAUTH_SECRET=replace-with-the-same-secret-used-by-saloncapprepo

# google | sarvam  (default: google). Invalid or unset values keep Google.
AI_PROVIDER=google

# Required when AI_PROVIDER=google
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Required when AI_PROVIDER=sarvam. Google keys can stay in place.
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya

# Server-rendered speech for devices with no Tamil/Hindi TTS voice.
# Used when AI_PROVIDER=google. Prefers Cloud Text-to-Speech and falls back
# to Gemini TTS. Defaults to GEMINI_API_KEY.
# GOOGLE_TTS_API_KEY=
# Optionally pin voices with TTS_VOICE_TA / TTS_VOICE_HI / TTS_VOICE_EN.

# Synthesized audio is cached here and reused. In production set this to
# a path outside the release dir, e.g. ~/SaloncappSOPTrainer/shared/tts-cache
# TTS_CACHE_DIR=
# TTS_WARM_ON_START=true
# TTS_WARM_LIMIT=24

CORS_ORIGIN=*
ASSESSMENT_QUESTION_COUNT=5
ASSESSMENT_TIME_LIMIT_SECONDS=300
