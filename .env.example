PORT=4010
# Dedicated Training DB only — do NOT use SaloncappRepo DB names (preprod/production).
# Same Atlas cluster is fine; database name must be separate, e.g. saloncapp_sop_trainer
MONGODB_URI=mongodb://127.0.0.1:27017/saloncapp_sop_trainer
NEXTAUTH_SECRET=same-secret-as-saloncappRepo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
CORS_ORIGIN=*
ASSESSMENT_QUESTION_COUNT=5
ASSESSMENT_TIME_LIMIT_SECONDS=300
